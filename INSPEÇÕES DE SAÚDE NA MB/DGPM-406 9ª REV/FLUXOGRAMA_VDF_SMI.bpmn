  <bpmn:collaboration id="Collaboration_0p29sd9">
    <bpmn:participant id="Participant_09xwwuc" name="FLUXOGRAMA DAS INSPEÇÕES DE SAÚDE FIM VDF NO SERVIÇO MILITAR OBRIGATÓRIO - DGPM-406 CAPÍTULO 11" processRef="Process_VDF_SMI" />
    <bpmn:textAnnotation id="TextAnnotation_1ivmjm2">
      <bpmn:text>IS REALIZADA POR MPI</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1by2sto">
      <bpmn:text>INFORMA A OM DE VINCULAÇÃO E O COM/3ºDN</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0olxzaz">
      <bpmn:text>NÃO CABE APS PARA IS FIM TÉRMINO DE INCAPACIDADE</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0dtjumd">
      <bpmn:text>Providências administrativas a cargo do ComDN CFM Art. 138 e 140 do RLSM</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r4k0ye">
      <bpmn:text>Laudos possíveis:
- APTO A
- INCAPAZ B-1 (&lt;1a)
- INCAPAZ B-2, (&gt;1a)
- INCAPAZ C. (definitiva, pressupõe ausência de nexo; com nexo → incapacidade definitiva para o SAM</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0itiire" associationDirection="None" sourceRef="Event_0fm8lnt" targetRef="TextAnnotation_1ivmjm2" />
    <bpmn:association id="Association_0z3d7zt" associationDirection="None" sourceRef="Event_0zt2uhl" targetRef="TextAnnotation_1by2sto" />
    <bpmn:association id="Association_1kosoh1" associationDirection="None" sourceRef="Task_ManterVDF" targetRef="TextAnnotation_0olxzaz" />
    <bpmn:association id="Association_06yfuqd" associationDirection="None" sourceRef="Activity_03oanwn" targetRef="TextAnnotation_0dtjumd" />
    <bpmn:association id="Association_0q9nq9s" associationDirection="None" sourceRef="Gateway_LaudoJRS" targetRef="TextAnnotation_1r4k0ye" />
  </bpmn:collaboration>
