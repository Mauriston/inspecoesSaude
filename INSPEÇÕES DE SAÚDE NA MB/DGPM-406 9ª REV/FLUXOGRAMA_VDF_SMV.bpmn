    <bpmn:textAnnotation id="TextAnnotation_0fcpjqn">
      <bpmn:text>LAUDO ENVIADO POR MSG PARA OM, PESMAR E TERDIS</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0hwgmij">
      <bpmn:text>FLUXOGRAMA NORDINAV NATAL nº 90-03/2026:
- ESGOTAMENTO DOS RECUROS DE TRAMENTO; ou
- ESTABILIZAÇÃO DA CONDIÇÃO DE SAÚDE</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1cunjcj">
      <bpmn:text>ENCOSTAMENTO:
- MANUTENÇÃO DO VÍNCULO COM A MB PARA TRATAMENTO DE SAÚDE SEM PRECEPÇÃO DE REMUNERAÇÃO</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1033mim">
      <bpmn:text>- MIL PASSA À CONDIÇÃO DE AGREGADO PARA TRATAMENTO DE SAÚDE COM PERCEPÇÃO DA REMUNERAÇÃO
- É MANTIDO O VÍNCULO MILITAR, PORÉM SEM SERVIÇO</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0sgm02b">
      <bpmn:text>LAUDO DO PADRÃO DO CAPÍTULO 6 DA DGPM-406</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_07269il">
      <bpmn:text>IS REALIZADA POR MPI</bpmn:text>
    </bpmn:textAnnotation>
