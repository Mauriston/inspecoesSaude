views:
  - type: table
    name: Tabela
    filters:
      and:
        - tipo != "Fluxograma BPMN"
        - tipo != "Anexo"
        - documento == "DGPM-406"
    order:
      - title
      - competencia_mpi_jrs
      - file.name
    sort:
      - property: title
        direction: ASC
      - property: competencia_mpi_jrs
        direction: DESC
    columnSize:
      note.title: 434
      note.competencia_mpi_jrs: 211
